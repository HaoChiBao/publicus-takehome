# ---- Pipeline + FastAPI backend ----
# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_KEY=xxx          # service role key — used by the pipeline for writes

# Direct Postgres connection string for asyncpg (Supabase -> Project Settings -> Database).
# Use the "Connection pooling" / Session string. Example:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# OpenAI (GPT-4o-mini for enrichment + recipient confirmation)
OPENAI_API_KEY=xxx

# Set to 0 only if HTTPS downloads fail due to a corporate TLS proxy.
SSL_VERIFY=1
