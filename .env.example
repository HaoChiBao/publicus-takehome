# ---- Pipeline + FastAPI backend ----
# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_KEY=xxx          # service role key — used by the pipeline for writes

# Session pooler URI from Supabase → Connect → Shared Pooler (port 5432).
# Replace YOUR_DB_PASSWORD with your database password (not the anon/secret API keys).
# Required for the FastAPI backend and pipeline upload — the API reads grant data from Postgres when this is set.
DATABASE_URL=postgresql://postgres.[project-ref]:YOUR_DB_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# OpenAI (GPT-4o-mini for enrichment + recipient confirmation)
OPENAI_API_KEY=xxx

# Set to 0 only if HTTPS downloads fail due to a corporate TLS proxy.
SSL_VERIFY=1
