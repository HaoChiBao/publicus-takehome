# URL of the FastAPI backend (local dev default below).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (only needed if you choose to talk to Supabase directly from the
# client; the app talks to the FastAPI backend by default).
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
